{
  "name": "raycast-ielts-vocab-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Raycast MCP server that classifies chat vocabulary into IELTS Task 2 topics.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.0"
  }
}
